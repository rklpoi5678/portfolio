// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Project 모델
model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  images      Json // 배열 타입은 String[] 또는 Json으로 표현 가능

  // Creator와의 1:1 관계 (필수)
  creatorId   Int
  creator     Creator  @relation(fields: [creatorId], references: [id])

  // Links와의 1:N 관계 (선택적)
  links       Link[]

  // Stats와의 1:1 관계 (필수)
  statsId     Int      @unique // Stat 모델과의 1:1 관계를 위한 고유 키
  stats       Stat     @relation(fields: [statsId], references: [id])

  // Tool와의 N:M 관계 명시적인 중간테이블을 사용해야한다.
  projectTools ProjectTool[] // ProjectTool 모델을 통한 다대다 관계구현

  // Tags는 단순 문자열 배열이므로 String[] 사용
  tags        Json

  createdAt   DateTime @default(now())

  // createdAt을 `String` 대신 `DateTime`으로 변경했습니다.
  // `2025-04-10`과 같은 형식은 Prisma에서 `DateTime`으로 처리 가능합니다.
}


// Creator 모델
model Creator {
  id        Int      @id @default(autoincrement())
  name      String
  avatar    String
  followers String   // "12.5k"와 같은 문자열은 String으로 저장
  projects  Project[] // Creator는 여러 Project를 가질 수 있습니다.
}

// Link 모델
model Link {
  id        Int     @id @default(autoincrement())
  title     String
  url       String
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])
}

// Stat 모델 (Project와 1:1 관계)
model Stat {
  id       Int     @id @default(autoincrement())
  views    Int
  likes    Int
  comments Int
  project  Project? // Project와의 1:1 관계 (Stat이 Project에 의해 생성될 수 있음)
}

// Tool 모델 (N:M 관계를 위한 독립적인 모델)
model Tool {
  id       Int      @id @default(autoincrement())
  name     String   @unique // 도구 이름은 고유해야 합니다.
  projectTools ProjectTool[] // 여러 프로젝트에서 하나의 도구를 사용할 수 있습니다.
}

// 다대다 관계를 위한 명시적인 중간 테이블 (조인 테이블)
model ProjectTool {
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  toolId Int
  tool   Tool @relation(fields: [toolId], references: [id])

  @@id([projectId, toolId]) // 복합적인 기본키
}